{
  "name": "@metron/sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./clients": "./clients.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint index.ts clients.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@metron/abi": "workspace:*",
    "@metron/protocol": "workspace:*",
    "@metron/types": "workspace:*",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@metron/typescript-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
